APP_ENV=local
APP_NAME=foodapp-backend
APP_VERSION=0.1.0
LOG_LEVEL=debug
LOG_FORMAT=console

HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=foodapp
POSTGRES_PASSWORD=foodapp_local_pw
POSTGRES_DB=foodapp
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_MAX_LIFETIME=30m

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# CHANGE THESE before deploying anywhere beyond local dev.
JWT_ACCESS_SECRET=local_dev_access_secret_change_me
JWT_REFRESH_SECRET=local_dev_refresh_secret_change_me
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h
JWT_ISSUER=foodapp

OTP_LENGTH=6
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=30s
OTP_MAX_REQUESTS_PER_DAY=10

S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET=foodapp-media
S3_ACCESS_KEY_ID=foodapp
S3_SECRET_ACCESS_KEY=foodapp_local_pw
S3_USE_SSL=false
S3_PRESIGN_TTL=15m

SMS_PROVIDER=mock
EMAIL_PROVIDER=mock

RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_HOUR=10
RATE_LIMIT_GLOBAL_RPS=50
